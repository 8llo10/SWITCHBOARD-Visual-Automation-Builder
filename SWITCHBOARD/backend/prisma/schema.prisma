generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  OPERATOR
  VIEWER
}

enum WorkflowStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum RunStatus {
  QUEUED
  RUNNING
  WAITING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum StepStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  SKIPPED
  WAITING
}

model User {
  id                  String              @id @default(cuid())
  email               String              @unique
  name                String
  passwordHash        String
  role                Role                @default(OPERATOR)
  active              Boolean             @default(true)
  emailVerifiedAt     DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  workflows           Workflow[]
  auditEvents         AuditEvent[]
  verificationTokens  EmailVerificationToken[]
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  usedAt    DateTime?

  @@index([userId, createdAt])
  @@index([expiresAt])
}

model Workflow {
  id          String         @id @default(cuid())
  name        String
  slug        String         @unique
  description String?
  status      WorkflowStatus @default(DRAFT)
  definition  Json
  version     Int            @default(1)
  ownerId     String?
  owner       User?          @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  runs        WorkflowRun[]
  triggers    Trigger[]

  @@index([ownerId, updatedAt])
}

model Trigger {
  id         String   @id @default(cuid())
  workflowId String
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  type       String
  enabled    Boolean  @default(true)
  config     Json     @default("{}")
  secret     String?  @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([workflowId, enabled])
}

model WorkflowRun {
  id             String         @id @default(cuid())
  workflowId     String
  workflow       Workflow       @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  status         RunStatus      @default(QUEUED)
  triggerType    String
  triggerPayload Json
  context        Json           @default("{}")
  startedAt      DateTime?
  finishedAt     DateTime?
  error          String?
  createdAt      DateTime       @default(now())
  steps          WorkflowStep[]
  logs           RunLog[]

  @@index([workflowId, createdAt])
  @@index([status, createdAt])
}

model WorkflowStep {
  id         String      @id @default(cuid())
  runId      String
  run        WorkflowRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  nodeId     String
  nodeType   String
  label      String
  status     StepStatus  @default(PENDING)
  input      Json?
  output     Json?
  error      String?
  attempt    Int         @default(1)
  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime    @default(now())

  @@unique([runId, nodeId, attempt])
}

model RunLog {
  id        String      @id @default(cuid())
  runId     String
  run       WorkflowRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  level     String      @default("info")
  nodeId    String?
  message   String
  meta      Json?
  createdAt DateTime    @default(now())

  @@index([runId, createdAt])
}

model DirectoryUser {
  id         String   @id @default(cuid())
  email      String   @unique
  fullName   String
  department String?
  title      String?
  active     Boolean  @default(true)
  groups     String[] @default([])
  licenses   String[] @default([])
  custom     Json     @default("{}")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Credential {
  id            String   @id @default(cuid())
  name          String   @unique
  type          String
  encryptedData String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model AuditEvent {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([entity, entityId])
}
